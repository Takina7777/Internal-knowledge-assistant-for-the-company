# ===== LLM（deepseek-v4-flash，OpenAI 兼容接口）=====
# 复制本文件为 .env 并填写真实值（.env 已被 gitignore，请勿把真实 key 写回本文件）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx-请填写
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ===== Embedding（本地 Ollama bge-m3）=====
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=32

# ===== 向量库（chroma | qdrant，qdrant 为 Phase 2 迁移目标）=====
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_docs
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_docs

# ===== Redis / Celery =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 开发环境用 fakeredis（不支持 Lua）时置 true；真实 Redis 必须 false
CELERY_DEV_NO_LUA=false

# ===== 认证（JWT + 本地账号）=====
# AUTH_PROVIDER=jwt | oidc（oidc 为 Phase 2 对接公司 SSO）
AUTH_PROVIDER=jwt
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me  # 首次启动自动创建管理员，请务必修改
DB_PATH=./data/app.db

# ===== 企业微信（Phase 2 接入，暂留占位）=====
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=

# ===== 可观测（noop | langfuse，Langfuse 为 Phase 2 自托管）=====
OBSERVABILITY_PROVIDER=noop
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ===== 应用 =====
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
RETRIEVE_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
UPLOAD_DIR=./data/uploads
